# Основные настройки приложения
GATEWAY_APP_NAME=Trading Gateway
GATEWAY_DEBUG=true
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# База данных (по умолчанию локальный SQLite в каталоге сервиса)
GATEWAY_DATABASE_URL=sqlite:///./gateway.db

# JWT и безопасность
GATEWAY_SECRET_KEY=change-me
GATEWAY_ACCESS_TOKEN_EXPIRE_MINUTES=30
GATEWAY_REFRESH_TOKEN_EXPIRE_MINUTES=10080
GATEWAY_TOKEN_ALGORITHM=HS256
GATEWAY_STARTING_EQUITY=10000

# Учётные данные суперпользователя, создаваемого при первом запуске
GATEWAY_FIRST_SUPERUSER_EMAIL=admin@example.com
GATEWAY_FIRST_SUPERUSER_PASSWORD=admin
GATEWAY_FIRST_SUPERUSER_OTP_SECRET=JBSWY3DPEHPK3PXP

# Настройки CORS (через запятую)
GATEWAY_CORS_ORIGINS=http://localhost:3000
